#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        COMBO_BS {
            bindings = <&kp BACKSPACE>;
            key-positions = <13 14>;
            timeout-ms = <40>;
            layers = <0>;
        };

        COMBO_DE {
            bindings = <&kp DELETE>;
            key-positions = <15 16>;
            timeout-ms = <40>;
            layers = <0>;
        };

        COMBO_Ln1 {
            bindings = <&kp LANG1>;
            key-positions = <16 17>;
            timeout-ms = <40>;
            layers = <0>;
        };

        COMBO_Ln2 {
            bindings = <&kp LANG2>;
            key-positions = <13 12>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp L      &kp U           &kp COMMA    &kp PERIOD                                                  &kp F      &kp W        &kp R              &kp Y      &kp P
&mt LCTRL E        &kp I      &mt LEFT_ALT A  &mt LCTRL O  &kp MINUS                                                   &kp K      &mt RCTRL T  &mt RCTRL N        &kp S      &kp H
&mt2 LEFT_SHIFT Z  &kp X      &kp C           &kp V        &kp SEMICOLON                                               &kp G      &kp D        &kp M              &kp J      &kp B
&kp LCTRL          &kp LWIN   &kp LEFT_ALT    &mo 1        &kp BACKSPACE  &mt LEFT_SHIFT SPACE  &mt RIGHT_SHIFT SPACE  &kp ENTER  &mo 2        &kp RIGHT_CONTROL  &kp AT     &kp RIGHT_SHIFT
                   &none      &kp RIGHT       &kp DOWN     &kp LEFT       &kp UP                &kp UP                 &kp LEFT   &kp DOWN     &kp RIGHT          &none
&mkp LCLK          &mkp RCLK  &mkp MCLK                                                                                                        &mkp LCLK          &mkp RCLK  &mkp MCLK
&mkp MB4           &mkp MB5   &kp LG(TAB)     &kp LG(D)    &kp LCTRL                                                   &mkp MB4   &mkp MB5     &kp LG(TAB)        &kp LG(D)  &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp EXCLAMATION   &kp PAGE_UP        &kp UP    &kp PAGE_DOWN  &kp HOME                    &kp PERIOD        &kp N7             &kp N8  &kp N9     &kp PLUS
&trans            &kp LEFT           &kp DOWN  &kp RIGHT      &kp END                     &kp COMMA         &kp N4             &kp N5  &kp N6     &kp MINUS
&trans            &trans             &trans    &trans         &kp K_MUTE                  &kp EQUAL         &kp N1             &kp N2  &kp N3     &kp RS(DOUBLE_QUOTES)
&trans            &trans             &trans    &trans         &trans      &trans  &trans  &trans            &trans             &kp N0  &kp PRCNT  &kp RS(COMMA)
                  &trans             &trans    &trans         &trans      &trans  &trans  &trans            &trans             &trans  &trans
&trans            &trans             &trans                                                                                    &trans  &trans     &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans    &trans         &trans                      &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans  &trans     &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp LS(LESS_THAN)  &kp LS(GREATER_THAN)  &kp LS(QUESTION)  &kp LS(N8)       &kp LS(N9)                     &kp PAGE_UP    &kp HOME  &kp UP_ARROW    &kp END           &kp PRINTSCREEN
&kp LS(MINUS)      &kp CARET             &kp LEFT_BRACKET  &kp PLUS         &kp BACKSLASH                  &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT         &kp HASH
&kp AMPERSAND      &kp LS(AT_SIGN)       &kp CARET         &kp RIGHT_BRACE  &kp PIPE                       &kp SLASH      &kp DQT   &kp AMPS        &kp DLLR          &kp QUESTION
&kp SLASH          &kp COLON             &kp SEMICOLON     &trans           &trans         &trans  &trans  &trans         &trans    &kp TILDE       &kp LS(ASTERISK)  &kp LS(UNDERSCORE)
                   &trans                &trans            &trans           &trans         &trans  &trans  &trans         &trans    &trans          &trans
&trans             &trans                &trans                                                                                     &trans          &trans            &trans
&trans             &trans                &trans            &trans           &trans                         &trans         &trans    &trans          &trans            &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
